meta {
  name: Test SQL Generation
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/generate/v1/
  body: json
  auth: inherit
}

body:json {
  {
    "name": "SQL Test Generator",
    "description": "Generate SQL INSERT statements for database seeding",
    "data_type": "sql",
    "count": 100,
    "schema": {
      "table": "employees",
      "columns": {
        "id": {"type": "integer", "primary_key": true},
        "first_name": {"type": "varchar", "length": 50},
        "last_name": {"type": "varchar", "length": 50},
        "email": {"type": "varchar", "length": 100, "unique": true},
        "hire_date": {"type": "date"},
        "salary": {"type": "decimal", "precision": 10, "scale": 2}
      }
    },
    "format": "insert_statements",
    "enabled": true,
    "user_id": "user-123"
  }
}